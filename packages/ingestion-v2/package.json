{
  "name": "@missa/ingestion-v2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "bin": {
    "missa-ingestion-v2-schema": "dist/src/cli.js",
    "missa-ingestion-v2-worker": "dist/src/worker.js",
    "missa-ingestion-v2-run": "dist/src/run-cli.js",
    "missa-ingestion-v2-compare": "dist/src/compare-cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/test/*.test.js",
    "schema:ensure": "npm run build && missa-ingestion-v2-schema",
    "worker": "node dist/src/worker.js"
  },
  "dependencies": {
    "@missa/radar-engine": "^0.1.0",
    "bullmq": "^5.58.5",
    "ioredis": "^5.6.1",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "@types/pg": "^8.11.0",
    "typescript": "^5.9.3"
  }
}
