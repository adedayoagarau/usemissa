{
  "name": "@missa/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config=drizzle.config.ts",
    "db:rehearse-taxonomy": "node scripts/rehearse-taxonomy.mjs",
    "db:seed-taxonomy": "npm run build --workspace=@missa/taxonomy && npm run build && node scripts/seed-taxonomy.mjs",
    "test": "npm run build && node --test dist/test/*.test.js"
  },
  "dependencies": {
    "@missa/taxonomy": "0.1.0",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "@types/pg": "^8.20.0",
    "typescript": "^5.9.3"
  }
}
