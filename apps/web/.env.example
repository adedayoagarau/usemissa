# Optional external analytics sink. The first-party platform_analytics_events
# ledger works without these values.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Neon connection strings should pin certificate verification explicitly:
# sslmode=verify-full. Do not use sslmode=require: it is a weaker alias in
# pg-connection-string v3 and will stop enforcing the server certificate.
# DATABASE_URL="postgresql://user:pass@host/db?sslmode=verify-full&channel_binding=require"
# Enable approved Opportunity Intelligence reads only after the additive
# opportunity-content migration has been applied and rehearsed.
MISSA_OPPORTUNITY_CONTENT_READS=0
MISSA_TAXONOMY_READS=0
MISSA_OPPORTUNITY_REPOSITORY=engine
MISSA_CREATOR_RELATIONAL_AUTHORITY=0
MISSA_CHAT_ENABLED=0
NEXT_PUBLIC_MISSA_CHAT_ENABLED=0

# Transactional email and signed delivery-event reconciliation.
RESEND_API_KEY=
RESEND_FROM=Missa <notifications@usemissa.com>
RESEND_WEBHOOK_SECRET=

# Neon Auth. Vercel's Neon integration provides DATABASE_NEON_AUTH_BASE_URL;
# local development can use NEON_AUTH_BASE_URL instead. Set the public flag to
# 1 only when that environment has a configured Neon Auth branch. Generate the
# cookie secret with: openssl rand -base64 32
NEON_AUTH_BASE_URL=
NEXT_PUBLIC_NEON_AUTH_URL=
NEXT_PUBLIC_NEON_AUTH_ENABLED=0
NEON_AUTH_COOKIE_SECRET=

# Compatibility session signing and shared authentication abuse protection.
# The local limiter falls back to bounded process memory, but hosted instances
# should use the shared Upstash path so limits survive multiple web instances.
MISSA_SESSION_SECRET=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Vercel KV-compatible aliases, if those are the names supplied by the
# hosting integration. A native Upstash redis:// or rediss:// URL is also
# accepted when it contains a password/token.
KV_REST_API_URL=
KV_REST_API_TOKEN=
REDIS_URL=

# Public legal pages. The operating entity and its postal address are real
# facts only the operator can supply, so they stay unset until provided.
# While unset, /privacy and /terms publish the verified contact email only.
NEXT_PUBLIC_MISSA_CONTACT_EMAIL=
NEXT_PUBLIC_MISSA_LEGAL_ENTITY=
NEXT_PUBLIC_MISSA_LEGAL_ADDRESS=

# Optional third-party product analytics. Leave unset to run on the
# first-party event ledger alone. Analytics never runs before a visitor
# accepts the consent banner.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# Optional error tracking. Nothing loads or sends without a DSN. No session
# replay and no default PII; query strings are stripped from reported URLs.
# Tracing stays off unless a sample rate between 0 and 1 is set. Source maps
# upload only when SENTRY_AUTH_TOKEN, SENTRY_ORG and SENTRY_PROJECT are set.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Creator worker (Railway MISSA_WORKER_MODE=creator). Optional bounds for the
# per-pass calendar export drain and the readiness freshness window.
MISSA_CALENDAR_SYNC_BATCH_SIZE=
MISSA_CALENDAR_SYNC_TIME_BUDGET_MS=
MISSA_CREATOR_TICK_STALE_AFTER_SECONDS=

# Review agent (Railway review-agent service, read here only for reference).
# auto (default) publishes records that pass every automated gate with no
# person in the loop; queue is opt-in oversight that holds them at /admin/radar.
RADAR_REVIEW_PUBLISH_MODE=
