{
  "$schema": "./component-policy.schema.json",
  "version": "0.1.0",
  "status": "binding-for-new-ui",
  "instructionEntrypoints": [
    "AGENTS.md",
    "docs/ai-ui-build-directive.md",
    ".github/copilot-instructions.md",
    ".cursor/rules/missa-ui.mdc"
  ],
  "sources": {
    "installed": "@/components/ui",
    "studioLocal": "@/components/shadcn-studio",
    "shadcn": "@shadcn",
    "studioComponents": "@ss-components",
    "studioBlocks": "@ss-blocks",
    "studioPages": "@ss-pages",
    "coss": "selective-review-only"
  },
  "sourcePriority": [
    "installed",
    "shadcn",
    "studioComponents",
    "studioBlocks",
    "studioPages",
    "coss",
    "custom-with-rationale"
  ],
  "typography": {
    "editorial": "Newsreader",
    "interface": "Instrument Sans",
    "data": "Fragment Mono"
  },
  "tokens": {
    "required": true,
    "allowedColorRoles": [
      "canvas",
      "surface",
      "ink",
      "primary",
      "success",
      "warning",
      "destructive",
      "information",
      "border",
      "focus"
    ],
    "forbidFeatureHex": true,
    "forbidFeatureFontFamily": true,
    "forbidArbitraryRadius": true,
    "forbidArbitraryAnimation": true
  },
  "intents": {
    "composition.liquid-glass-welcome": {
      "semantic": "LiquidGlassWelcome",
      "composition": [
        "Button",
        "Link",
        "DecorativeCanvas"
      ],
      "appearance": "white-editorial-with-refractive-forest-scene",
      "boundary": "Optional /welcome entry; finite gesture-driven artwork; real /onboarding and /opportunities links; does not alter account onboarding state."
    },
    "composition.application-tracker-preview": {
      "semantic": "ApplicationTrackerPreview",
      "composition": [
        "Button",
        "Field",
        "Input",
        "Textarea",
        "NativeSelect"
      ],
      "boundary": "Device-local preview; no notification delivery or live calendar sync."
    },
    "composition.application-preparation": {
      "semantic": "ApplicationPreparation",
      "implementation": "apps/web/components/missa/application-preparation.tsx",
      "composition": [
        "Button",
        "Checkbox",
        "Progress",
        "Dialog",
        "Field",
        "Input",
        "NativeSelect",
        "Skeleton"
      ],
      "boundary": "Account-owned canonical applications and preparation; explicit recorded events, no submission on external navigation."
    },
    "input.creator-handle": {
      "semantic": "PortfolioHandleField",
