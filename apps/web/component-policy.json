      "composition": [
        "CreatorShell",
        "Button",
        "Input",
        "NativeSelect",
        "Dialog",
        "ApplicationLabels",
        "Progress"
      ],
      "boundary": "Fictional local-state goals. No persistence, recommendation ranking or reminder delivery.",
      "evidence": "docs/my-applications/goals.md"
