      "mediaSelection": "labelled-button-trigger-with-replace-remove-and-preview"
    },
    "composition.creator-portfolio": {
      "semantic": "CreatorPortfolioStudio",
      "composition": [
        "Button",
        "Input",
        "Textarea",
        "Dialog",
        "InstitutionSocialLinks"
      ],
      "appearance": "editorial-public-portfolio-with-separate-owner-settings",
      "variants": [
        "public-profile",
        "embedded-marketing-sample"
      ],
      "embeddedBoundary": "Optional embedded sample removes nested main/h1 and contact/credit modules; retains actual work filters and reading/image disclosures. No ownerId, account loading or writes. Explicit fictional sample label remains visible."
    },
    "composition.creator-onboarding": {
      "semantic": "CreatorOnboarding",
