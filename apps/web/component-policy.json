      "semantic": "MagazineRankingsInteractive",
      "composition": [
        "Table",
        "Field",
        "Input",
        "NativeSelect",
        "Button",
        "Empty",
        "MagazineScheduleBadge",
        "MagazineTrackerAction"
      ],
      "appearance": "white-editorial-index",
      "boundary": "Explicit seed preview; server-derived scores; no inferred submission or response."
    },
    "composition.discovery-journey-preview": {
      "semantic": "JourneyPreview",
      "composition": [
        "Link",
        "Button",
        "Field",
        "Input",
        "existing page components",
        "CreatorOnboardingPreview"
      ],
      "boundary": "Isolated local review route; signup is simulated; opportunity page reused unchanged; teal scoped to rankings preview."
    },
    "composition.homepage-focused": {
      "semantic": "HomepageFocusedPreview",
      "composition": [
        "HomepageHeroPreview",
        "HomepageNextOpening",
        "HomepageContinuation",
        "HomepagePortfolio",
        "HomepageFooter"
      ],
      "boundary": "Experimental review route. Navigation uses descriptive category links; live totals retain loading and retry states. HomepagePortfolio presents the canonical portfolio with installed Button theme choices; no account writes. Existing marketing tokens only. Footer painting shares one semantic footer with navigation and fades into its surface."
    },
    "composition.homepage-studio": {
      "semantic": "HomepageStudio",
      "composition": [
        "Button",
        "Link",
        "Switch",
        "Sheet",
        "Alert",
        "Item",
        "ResponsiveImage"
      ],
      "appearance": "white-editorial-with-original-studio-photography",
      "boundary": "Finite user-requested 280ms panel phases; still equivalent; scene selection never saves preferences or submits work. Native responsive images, no generated video dependency."
    },
    "composition.video-world": {
      "semantic": "VideoWorld",
      "composition": [
        "Button",
        "Link",
        "NativeVideo"
      ],
      "appearance": "fullscreen-photographic-world-with-local-glass-controller",
      "boundary": "Experimental attributed reference study. Persistent video layers, user-requested forward/reverse clips, no live generation; not original Missa footage. Scoped 980ms controller choreography follows explicit cinematic direction."
    },
    "composition.applications-design-preview": {
      "semantic": "ApplicationsDesignPreview",
      "composition": [
        "Tabs",
        "Button",
        "Field",
        "Input",
        "Textarea",
        "Dialog",
        "NativeSelect",
        "Empty",
        "Alert",
        "Skeleton",
        "Link",
        "CreatorShell",
        "ApplicationLabels"
      ],
      "boundary": "Isolated fictional design study; memory-only changes; no account writes, application destinations or reminder delivery."
    },
    "composition.homepage-next-opening": {
      "semantic": "HomepageNextOpening",
      "composition": [
        "Carousel",
        "CarouselContent",
        "CarouselItem",
        "Card",
        "CardHeader",
        "CardTitle",
        "CardDescription",
        "CardFooter",
        "Button",
        "Skeleton",
        "Link",
        "Image"
      ],
      "boundary": "Installed Embla with the wheel-gestures plugin for horizontal trackpad input, looping category navigation, pointer and keyboard controls. Card-05 image/content adaptation, four staggered live metrics, responsive container queries, reduced-motion equivalent and loading skeletons. Organizations uses the public directory profile total; counts have a plus suffix, never a fabricated value."
    },
    "composition.goals-preview": {
      "semantic": "GoalsPreview",
