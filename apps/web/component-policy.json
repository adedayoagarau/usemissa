      "semantic": "HomepageWorkspace",
      "implementation": "apps/web/components/missa/homepage-workspace.tsx",
      "composition": [
        "Tabs",
        "TabsList",
        "TabsTrigger",
        "TabsContent",
        "Table",
        "TableHeader",
        "TableBody",
        "TableRow",
        "TableHead",
        "TableCell",
        "CreatorPortfolioStudio",
        "GoalSubmissionProgress",
        "Switch",
        "Button",
        "Skeleton",
        "Link",
        "motion",
        "Image"
