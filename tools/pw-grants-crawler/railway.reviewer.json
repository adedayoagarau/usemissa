{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "/tools/pw-grants-crawler/Dockerfile",
    "watchPatterns": ["/tools/pw-grants-crawler/**"]
  },
  "deploy": {
    "startCommand": "gary-review-worker --poll-seconds 60",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
